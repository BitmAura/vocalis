# Vocalis Oracle — smooth voice (Media Stream)
# Copy to backend/.env on your Oracle VM and fill in values.

PORT=3300
NODE_ENV=production

# === REQUIRED for smooth phone voice ===
USE_MEDIA_STREAM=true
# Public HTTPS URL from Cloudflare Tunnel (must support WSS)
PUBLIC_BASE_URL=https://voice.yourdomain.com
VOICE_WS_URL=wss://voice.yourdomain.com/v1/stream

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19803723727

# === AI brain ===
OPENROUTER_API_KEY=

# === Hear caller (strongly recommended on Oracle) ===
DEEPGRAM_API_KEY=

# === Speak back — pick ONE or both ===
# Option A: Google Cloud TTS (mulaw 8kHz direct — fastest for stream)
GOOGLE_TTS_API_KEY=

# Option B: OSS IndicF5 + Piper (no API key, needs Python on VM)
# PYTHON=py
# Install: cd backend/mit-voice && pip install -r requirements.txt

# === Optional ===
DEFAULT_DOCTOR_PHONE=+919845012345
ADMIN_API_KEY=
