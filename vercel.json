{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3.2.0",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/v1/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/v1/telephony/inbound",
      "destination": "/api/telephony.js"
    },
    {
      "source": "/v1/tenants",
      "destination": "/api/tenants.js"
    },
    {
      "source": "/v1/bookings",
      "destination": "/api/bookings.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/admin/assets/$1"
    },
    {
      "source": "/client-portal/(.*)",
      "destination": "/client-portal/$1"
    },
    {
      "source": "/(.*\\.(html|css|js|png|jpg|svg|json))",
      "destination": "/admin/$1"
    },
    {
      "source": "/",
      "destination": "/admin/index.html"
    }
  ]
}
