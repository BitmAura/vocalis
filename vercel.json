{
  "rewrites": [
    {
      "source": "/v1/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/v1/telephony/inbound",
      "destination": "/api/telephony"
    },
    {
      "source": "/v1/tenants",
      "destination": "/api/tenants"
    },
    {
      "source": "/v1/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/admin/assets/$1"
    },
    {
      "source": "/client-portal/(.*)",
      "destination": "/client-portal/$1"
    },
    {
      "source": "/(.*\\.(html|css|js|png|jpg|svg|json))",
      "destination": "/admin/$1"
    },
    {
      "source": "/",
      "destination": "/admin/index.html"
    }
  ]
}
